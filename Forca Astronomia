import tkinter as tk
from tkinter import messagebox
import random

class ForcaAstronomia:
    def __init__(self, root):
        self.root = root
        self.root.title("Forca Astronômica - O Desafio do Cosmos")
        self.root.geometry("900x750")
        self.root.configure(bg="#020617")
        
        self.banco_de_dados = {
            "NEBULOSA": "Nuvem de gás e poeira no espaço.",
            "EXOPLANETA": "Planeta que orbita uma estrela fora do Sol.",
            "SUPERNOVA": "Explosão estelar massiva.",
            "BURACO NEGRO": "Região com gravidade extrema.",
            "PULSAR": "Estrela de nêutrons que emite radiação.",
            "QUASAR": "Núcleo galáctico extremamente brilhante.",
            "PARALAXE": "Medição de distância por deslocamento.",
            "ASTEROIDE": "Corpo rochoso pequeno orbitando o Sol.",
            "COMETA": "Corpo de gelo e poeira com cauda.",
            "GALAXIA": "Sistema de bilhões de estrelas.",
            "CONSTELACAO": "Agrupamento aparente de estrelas.",
            "SOLSTICIO": "Evento astronômico de máxima inclinação solar.",
            "EQUINOCIO": "Quando dia e noite têm durações iguais.",
            "FOTOSSFERA": "Camada visível da superfície do Sol.",
            "MAGNETOSFERA": "Região magnética ao redor de um planeta.",
            "HELIO PAUSA": "Limite onde o vento solar encontra o meio interestelar.",
            "ANÃ BRANCA": "Remanescente de uma estrela de baixa massa.",
            "SINGULARIDADE": "Ponto central de densidade infinita.",
            "METEORO": "Rastro luminoso de um objeto na atmosfera.",
            "APHELIO": "Ponto da órbita mais distante do Sol.",
            "PERIELIO": "Ponto da órbita mais próximo do Sol.",
            "CROMOSFERA": "Camada da atmosfera solar acima da fotosfera.",
            "LUMINOSIDADE": "Quantidade total de energia emitida por uma estrela.",
            "ECLIPSE": "Obscurecimento de um corpo celeste por outro.",
            "ZENITE": "Ponto mais alto no céu acima do observador."
        }
        self.reiniciar_jogo()
        
    def reiniciar_jogo(self):
        self.palavra = random.choice(list(self.banco_de_dados.keys()))
        self.letras_tentadas = []
        self.erros = 0
        self.max_erros = 6
        for widget in self.root.winfo_children(): widget.destroy()
        self.setup_ui()
        
    def setup_ui(self):
        self.canvas = tk.Canvas(self.root, width=300, height=250, bg="#020617", highlightthickness=0)
        self.canvas.pack(pady=10)
        self.desenhar_base()
        
        self.lbl_palavra = tk.Label(self.root, text=self.get_display_word(), font=("Urbanist", 30, "bold"), bg="#020617", fg="#38bdf8")
        self.lbl_palavra.pack()
        
        # Histórico de letras
        self.lbl_historico = tk.Label(self.root, text="Letras usadas: ", font=("Arial", 12), bg="#020617", fg="white")
        self.lbl_historico.pack(pady=5)
        
        # Botão de Dica
        btn_dica = tk.Button(self.root, text="💡 Dica", command=self.mostrar_dica, bg="#f59e0b", fg="black", font=("Arial", 10, "bold"))
        btn_dica.pack(pady=5)
        
        frame_teclado = tk.Frame(self.root, bg="#020617")
        frame_teclado.pack(pady=10)
        
        for i, letra in enumerate("ABCDEFGHIJKLMNOPQRSTUVWXYZ"):
            btn = tk.Button(frame_teclado, text=letra, width=4, height=2, command=lambda l=letra: self.tentar_letra(l), bg="#1e293b", fg="white", relief="flat")
            btn.grid(row=i//9, column=i%9, padx=2, pady=2)

    def get_display_word(self):
        return " ".join([l if l in self.letras_tentadas or l == " " else "_" for l in self.palavra])

    def mostrar_dica(self):
        messagebox.showinfo("Dica Astronômica", self.banco_de_dados[self.palavra])

    def tentar_letra(self, letra):
        if letra in self.letras_tentadas: return
        self.letras_tentadas.append(letra)
        if letra not in self.palavra:
            self.erros += 1
            self.atualizar_forca()
        self.lbl_palavra.config(text=self.get_display_word())
        self.lbl_historico.config(text=f"Letras usadas: {', '.join(sorted(self.letras_tentadas))}")
        self.verificar_fim()

    def desenhar_base(self):
        self.canvas.create_line(50, 240, 250, 240, fill="white", width=4)
        self.canvas.create_line(100, 240, 100, 40, fill="white", width=4)
        self.canvas.create_line(100, 40, 200, 40, fill="white", width=4)
        self.canvas.create_line(200, 40, 200, 70, fill="white", width=2)

    def atualizar_forca(self):
        partes = [(180, 70, 220, 110), (200, 110, 200, 170), (200, 120, 170, 150), (200, 120, 230, 150), (200, 170, 175, 210), (200, 170, 225, 210)]
        if self.erros <= 6:
            if self.erros == 1: self.canvas.create_oval(partes[0], outline="white", width=3)
            else: self.canvas.create_line(partes[self.erros-1], fill="white", width=3)

    def verificar_fim(self):
        if "_" not in self.get_display_word():
            messagebox.showinfo("Sucesso!", f"Você acertou: {self.palavra}")
            self.reiniciar_jogo()
        elif self.erros >= 6:
            messagebox.showerror("Fim", f"A palavra era: {self.palavra}")
            self.reiniciar_jogo()

if __name__ == "__main__":
    app = tk.Tk()
    ForcaAstronomia(app)
    app.mainloop()
